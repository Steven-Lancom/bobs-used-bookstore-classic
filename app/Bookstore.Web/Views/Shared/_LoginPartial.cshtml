@if (User.Identity.IsAuthenticated)
{
    <div class="hstack gap-2">
        <a asp-area="" asp-controller="Address" asp-action="Index" class="nav-link text-dark me-2">Hello @User.Identity.Name!</a>

        @if (User.IsInRole("Administrators"))
        {
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link text-dark">Admin Portal</a>
            <div class="vr"></div>
        }
        <a asp-area="" asp-controller="Authentication" asp-action="LogOut" class="nav-link text-dark">Logout</a>
    </div>
}
else
{
    <a asp-area="" asp-controller="Authentication" asp-action="Login" class="nav-link text-dark">Log in</a>
}
